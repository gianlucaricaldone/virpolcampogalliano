# Applicazione (esposte al browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chiave-anon-locale>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chiave service role: letta dagli script in scripts/ e, dentro
# l'applicazione, solo da app/(app)/admin/utenti/actions.ts (tramite
# lib/supabase/servizio.ts) per creare gli account in auth.users, cosa che la
# chiave anon non può fare. Una regola ESLint impedisce ogni altro import.
SUPABASE_SERVICE_ROLE_KEY=<chiave-service-role-locale>

# Solo per i test sul database
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Migrazione: il progetto Supabase VECCHIO, in sola lettura. Vedi
# docs/superpowers/specs/2026-08-09-migrazione-dati-design.md. I valori
# stanno in .env.local e non si committano mai.
VECCHIO_SUPABASE_URL=
VECCHIO_SERVICE_ROLE_KEY=
